# Copy to .env and change every password. Never commit .env.

# Site
MOODLE_WWWROOT=https://ekalavya.local
MOODLE_SITE_FULLNAME=Ekalavya - Officers Training College, AMC Centre and College
MOODLE_SITE_SHORTNAME=Ekalavya
MOODLE_DEBUG=1

# Hidden technical Site Admin (tech team only, never given to the client's users)
MOODLE_ADMIN_USER=siteadmin
MOODLE_ADMIN_PASS=Change-Me-Str0ng!Pass
MOODLE_ADMIN_EMAIL=siteadmin@ekalavya.local

# Database VM
DB_HOST=db
DB_NAME=moodle
DB_USER=moodle
DB_PASS=Change-Me-Db-Pass-1
DB_ROOT_PASS=Change-Me-Root-Pass-1

# Redis (sessions)
REDIS_HOST=redis
REDIS_PASSWORD=Change-Me-Redis-Pass-1

# Proxy subnet whose X-Forwarded-For Moodle trusts (matches docker-compose app network)
TRUSTED_PROXY_SUBNET=172.28.10.0/24
